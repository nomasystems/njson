{minimum_otp_vsn, "25"}.
{erl_opts, [warnings_as_errors]}.

{shell, [njson]}.

{project_plugins, [
    erlfmt
]}.
{erlfmt, [write]}.

{profiles, [
    {bin_opt_info, [
        {erl_opts, [bin_opt_info]}
    ]},
    {test, [
        {erl_opts, [nowarn_export_all]},
        {deps, [
            {nct_util, {git, "https://github.com/nomasystems/nct_util.git", {branch, "main"}}},
            {triq, {git, "https://github.com/nomasystems/triq.git", {branch, "master"}}}
        ]}
    ]},
    {bench, [
        {deps, [
            {jsone, {git, "https://github.com/sile/jsone.git", {branch, "master"}}},
            thoas,
            {eflambe, {git, "https://github.com/Stratus3D/eflambe.git", {branch, "master"}}},
            {erlperf, {git, "https://github.com/max-au/erlperf.git", {branch, "master"}}}
        ]},
        {extra_src_dirs, [{"bench", [{recursive, false}]}]}
    ]}
]}.

{alias, [
    {check, [
        {fmt, "--check"},
        xref,
        dialyzer
    ]},
    {test, [
        {ct, "--spec test/conf/test.spec --cover --readable true --verbose"},
        {cover, "-m 75"}
    ]},
    {ci_test, [
        {ct, "--spec test/conf/ci_test.spec --cover --readable true"},
        {cover, "-m 75"}
    ]}
]}.

{cover_opts, [verbose]}.
{cover_enabled, true}.

{xref_ignores, [njson]}.
